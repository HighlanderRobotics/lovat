{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Dashboard window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "deep-link:default",
    "store:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.lovat.app/*" },
        { "url": "https://lovat.us.auth0.com/*" },
        { "url": "https://*.lovat.app/*" },
        { "url": "https://*.up.railway.app/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
