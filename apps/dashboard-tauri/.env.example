# Copy to .env for local development. Names match the Flutter Dashboard's --dart-define keys.
LOVAT_API_BASE=https://api.lovat.app
LOVAT_WEBSITE_URL=https://lovat.app

# Sandbox web builds: set all three together, pointing away from production.
# LOVAT_SANDBOX_AUTH0_DOMAIN=
# LOVAT_SANDBOX_AUTH0_WEB_CLIENT_ID=
# LOVAT_SANDBOX_AUTH0_AUDIENCE=

# `npm run dev` only: skip Auth0 and send this token (use with tool/dev-api.mjs).
# LOVAT_DEV_TOKEN=dev
