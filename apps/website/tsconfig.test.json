{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["node", "vitest/globals", "@testing-library/jest-dom", "gtag.js"],
		"checkJs": false
	},
	"include": [
		"test/**/*.ts",
		"e2e/**/*.ts",
		"playwright.config.ts",
		"vitest.config.ts",
		"src/**/*.d.ts",
		"src/**/*.svelte",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts"
	]
}
