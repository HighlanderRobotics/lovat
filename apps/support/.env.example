# Port to serve the API on. Defaults to 3000 when unset.
PORT=3001

# PostgreSQL connection string. Support shares the Server database, so this
# should match apps/server/.env for local development. Required.
DATABASE_URL=postgresql://lovat_local@127.0.0.1:55432/lovat_local

# Secret used to verify signed requests from Website and Dashboard. Must match
# the value those services sign with. Required.
LOVAT_SIGNING_KEY=

# Slack app credential for ticket notifications.
SLACK_API_KEY=
