{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/server/Dockerfile",
    "watchPatterns": ["/apps/server/**", "/packages/db/**"]
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "sh -c 'export DATABASE_URL=\"$DATABASE_PRIVATE_URL\"; npm --prefix ../../packages/db run db:deploy && exec npm start'",
    "sleepApplication": false,
    "useLegacyStacker": false,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 20,
    "healthcheckPath": "/status",
    "healthcheckTimeout": 1200
  },
  "environments": {
    "staging": {
      "deploy": {
        "limitOverride": {
          "containers": {
            "cpu": 2,
            "memoryBytes": 2147483648
          }
        },
        "multiRegionConfig": {
          "us-west2": {
            "numReplicas": 1
          }
        }
      }
    }
  }
}
