{
  "expo": {
    "name": "Collection",
    "slug": "lovat-collection",
    "platforms": ["ios", "android"],
    "version": "26.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.frc8033.lovatcollection",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "17"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#350868",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "package": "com.frc8033.lovatcollection",
      "versionCode": 28
    },
    "extra": {
      "eas": {
        "projectId": "a03e1f3b-bb81-4bb1-9961-2ec813f82b94"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "highlander-robotics",
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/with-ios-resource-targets.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1f1f1f",
          "imageWidth": 200,
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "scheme": "lovat-collection"
  }
}
