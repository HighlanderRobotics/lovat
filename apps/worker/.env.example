DATABASE_URL=postgresql://lovat_test:lovat_test@127.0.0.1:5432/lovat_test
TBA_KEY=
WORKER_CONCURRENCY=2
PORT=8080

# Opt-in only after reviewing a full-match scoreboard layout.
OCR_ENABLED=false
# JSON object matching src/ocr/media.ts templateSchema. See docs/scoreboard-ocr.md.
# OCR_SCOREBOARD_TEMPLATE=

# Optional event allowlist and bounded backlog mode (set only on the intended preview).
# OCR_TOURNAMENT_KEYS=2026cacg
OCR_BATCH=false

# Optional isolated Rust processor; unset URL to keep the CLI reference extractor.
# Use private networking in deployments; configure the same random token on both services.
# OCR_SERVICE_URL=http://ocr.railway.internal:8080
# OCR_SERVICE_TOKEN=
