{
  "name": "lovat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js",
    "benchmark": "npm run build && node tools/benchmark.mjs",
    "prebuild": "npm --prefix ../../packages/api run build",
    "postinstall": "npm --prefix ../../packages/api ci --ignore-scripts && npm --prefix ../../packages/api run build",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format:check": "prettier --check .",
    "inventory": "node tools/inventory.mjs",
    "inventory:check": "node tools/inventory.mjs --check"
  },
  "engines": {
    "node": ">=22.20.0 <23 || >=24"
  },
  "dependencies": {
    "@lovat/api": "file:../../packages/api",
    "@lovat/db": "file:../../packages/db",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "prettier": "3.9.9"
  }
}
