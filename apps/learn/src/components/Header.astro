---
import Search from "@astrojs/starlight/components/Search.astro";
import Logo from "../assets/logo.png";
---

<div class="header">
  <div class="logo-page-small">
    <a href="https://frc8033.com/" target="_blank">
      <img src={Logo.src} alt="8033" />
    </a>
  </div>
  <div class="actions">
    <div class="logo">
      <a href="https://frc8033.com/" target="_blank">
        <img src={Logo.src} alt="8033" />
      </a>
    </div>
    <a
      class="main-title"
      href={import.meta.env.PUBLIC_WEBSITE_URL || "https://lovat.app"}>Lovat</a
    >
    <Search {...Astro.props} />
  </div>
</div>

<style>
  img {
    width: 93px;
    height: 27px;
    transform: translateY(10%);
  }

  :global([data-theme="light"]) img {
    filter: brightness(0); /* Keep the existing monochrome logo readable. */
  }

  .logo {
    width: 352px;
  }

  .actions {
    /* padding-top: 0.25%; */
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform: translateY(5%);
  }

  .main-title {
    color: var(--victory-purple);
    font-size: 30px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-decoration: none;
  }

  .logo-page-small {
    appearance: none;
    border: none;
    background-color: transparent;
    cursor: pointer;
    display: none;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-right: 64px; /* Leave space for Starlight's native sidebar toggle. */
    }
    .logo-page-small {
      display: block;
      pointer-events: initial;
    }
    .actions {
      transform: none;
    }
    .actions .logo,
    .actions .main-title {
      display: none;
    }
    :global(site-search button[data-open-modal]) {
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>
