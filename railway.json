{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.server",
    "watchPatterns": [
      "/apps/server/**",
      "/packages/db/**",
      "/Dockerfile.server",
      "/railway.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "sh -c 'export DATABASE_URL=\"$DATABASE_PRIVATE_URL\"; exec npm start'",
    "sleepApplication": false,
    "useLegacyStacker": false,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 20,
    "healthcheckPath": "/status",
    "healthcheckTimeout": 1000
  },
  "environments": {
    "staging": {
      "deploy": {
        "limitOverride": {
          "containers": {
            "cpu": 2,
            "memoryBytes": 2147483648
          }
        },
        "multiRegionConfig": {
          "us-west2": {
            "numReplicas": 1
          }
        }
      }
    }
  }
}
