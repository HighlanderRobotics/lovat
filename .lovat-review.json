{
  "enabled": true,
  "reviewDrafts": false,
  "model": "anthropic/claude-sonnet-5.5",
  "maxDiffCharacters": 80000,
  "maxFindings": 20,
  "minimumConfidence": 0.75,
  "temperature": 0.1,
  "maxOutputTokens": 4096,
  "requestTimeoutMs": 120000,
  "maxRetries": 3,
  "categories": [
    "BUG",
    "SECURITY",
    "PERFORMANCE",
    "DATABASE",
    "TYPE_SAFETY",
    "ARCHITECTURE"
  ],
  "excludedPaths": [
    "node_modules/**",
    "**/node_modules/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    "**/build/**",
    "coverage/**",
    "**/coverage/**",
    ".dart_tool/**",
    "**/.dart_tool/**",
    "**/ios/Pods/**",
    "**/macos/Pods/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/bun.lockb",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.snap",
    "**/generated/**",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.pdf",
    "**/*.zip",
    "docs/history/**"
  ]
}
